#!/usr/bin/env python3
"""Installed-plugin command boundary for the bundled messaging runtime."""

from __future__ import annotations

import json
import os
import sys
import tempfile
from pathlib import Path


PLUGIN_ROOT = Path(__file__).resolve().parents[1]
RUNTIME_ROOT = PLUGIN_ROOT / "runtime"
WEBHOOK_ENVIRONMENT = "CODEX_DISCORD_WEBHOOK_URL"
MENTION_ENVIRONMENT = "CODEX_DISCORD_MENTION_USER_ID"
STATE_ENVIRONMENT = "CODEX_DISCORD_STATE_FILE"
DESTINATION_ENVIRONMENT = "CODEX_DISCORD_DESTINATION_TYPE"
CONFIG_FILENAME = "config.json"


def _plugin_data() -> Path:
    configured = os.environ.get("PLUGIN_DATA", "")
    if configured.strip():
        return Path(configured).expanduser()
    return Path.home() / ".codex" / "codex-discord"


def _config_file() -> Path:
    return _plugin_data() / CONFIG_FILENAME


def _stored_configuration() -> dict[str, str]:
    try:
        value = json.loads(_config_file().read_text())
    except (OSError, TypeError, ValueError):
        return {}
    if not isinstance(value, dict):
        return {}
    return {
        name: configured.strip()
        for name, configured in value.items()
        if name in (
            WEBHOOK_ENVIRONMENT,
            MENTION_ENVIRONMENT,
            DESTINATION_ENVIRONMENT,
        )
        and isinstance(configured, str)
        and configured.strip()
    }


def _apply_stored_configuration() -> None:
    for name, value in _stored_configuration().items():
        if not os.environ.get(name, "").strip():
            os.environ[name] = value


def _configure_runtime() -> None:
    sys.path.insert(0, str(RUNTIME_ROOT))
    _apply_stored_configuration()
    os.environ.setdefault(
        STATE_ENVIRONMENT,
        str(_plugin_data() / "routing.json"),
    )


def _write_private_configuration(values: dict[str, str]) -> None:
    directory = _plugin_data()
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(directory, 0o700)
    descriptor, temporary_name = tempfile.mkstemp(
        dir=directory,
        prefix=".config.",
    )
    temporary_path = Path(temporary_name)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w") as stream:
            json.dump(values, stream)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary_path, _config_file())
        os.chmod(_config_file(), 0o600)
    except Exception:
        temporary_path.unlink(missing_ok=True)
        raise


def _run_onboard(arguments: list[str]) -> int:
    from codex_discord.diagnostics import DISCORD_USER_ID, _webhook_is_usable
    from codex_discord.publisher import (
        DESTINATION_TYPES,
        DESTINATION_TEXT_CHANNEL,
        publish_message,
    )
    from onboarding import run_onboarding

    open_browser = True
    timeout_seconds = 900.0
    remaining = list(arguments)
    if "--no-open" in remaining:
        remaining.remove("--no-open")
        open_browser = False
    if "--timeout-seconds" in remaining:
        index = remaining.index("--timeout-seconds")
        try:
            timeout_seconds = float(remaining[index + 1])
        except (IndexError, ValueError):
            print(
                "usage: codex-discord onboard [--no-open] "
                "[--timeout-seconds SECONDS]",
                file=sys.stderr,
            )
            return 1
        del remaining[index : index + 2]
    if remaining:
        print(
            "usage: codex-discord onboard [--no-open] "
            "[--timeout-seconds SECONDS]",
            file=sys.stderr,
        )
        return 1

    def announce(value: object) -> None:
        json.dump(value, sys.stdout)
        sys.stdout.write("\n")
        sys.stdout.flush()

    try:
        result, exit_code = run_onboarding(
            state_file=os.environ[STATE_ENVIRONMENT],
            webhook_is_usable=_webhook_is_usable,
            user_id_is_usable=lambda value: (
                DISCORD_USER_ID.fullmatch(value) is not None
            ),
            publish_message=publish_message,
            store_configuration=_write_private_configuration,
            webhook_environment=WEBHOOK_ENVIRONMENT,
            mention_environment=MENTION_ENVIRONMENT,
            destination_environment=DESTINATION_ENVIRONMENT,
            destination_types=DESTINATION_TYPES,
            default_destination_type=DESTINATION_TEXT_CHANNEL,
            announce=announce,
            open_browser=open_browser,
            timeout_seconds=timeout_seconds,
        )
    except (OSError, ValueError) as error:
        print(f"onboarding failed: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        json.dump(
            {
                "status": "cancelled",
                "message": (
                    "Discord connection was cancelled. "
                    "No configuration was changed."
                ),
            },
            sys.stdout,
        )
        sys.stdout.write("\n")
        return 1
    json.dump(result, sys.stdout)
    sys.stdout.write("\n")
    return exit_code


def _print_uninstall() -> int:
    result = {
        "status": "removal-guidance",
        "steps": [
            (
                "Remove codex-discord from its configured marketplace, "
                "then restart Codex."
            ),
            "Verify /hooks no longer lists the plugin Stop and PermissionRequest hooks.",
            "Delete the private config file or stop exporting configuration values.",
            "Retain or remove the routing state and adjacent lock file intentionally.",
            "Delete the Discord webhook to revoke the credential when desired.",
        ],
        "private_config": str(_config_file()),
        "retained_state": str(_plugin_data() / "routing.json"),
        "documentation": str(PLUGIN_ROOT / "README.md"),
    }
    json.dump(result, sys.stdout)
    sys.stdout.write("\n")
    return 0


def _run_public_command(operation: str, arguments: list[str]) -> int:
    from codex_discord.__main__ import main

    assert operation == "doctor"
    sys.argv = ["codex-discord", "doctor", *arguments]
    return main()


def main() -> int:
    if len(sys.argv) < 2:
        print(
            "usage: codex-discord {onboard|doctor|stop-hook|"
            "attention-hook|uninstall}",
            file=sys.stderr,
        )
        return 1

    _configure_runtime()
    operation = sys.argv[1]
    arguments = sys.argv[2:]
    if operation == "onboard":
        return _run_onboard(arguments)
    if operation == "uninstall":
        return _print_uninstall()
    if operation == "doctor":
        return _run_public_command(operation, arguments)
    if arguments:
        print(f"{operation} does not accept arguments", file=sys.stderr)
        return 1
    if operation == "stop-hook":
        from codex_discord.stop_hook import main as hook_main

        return hook_main()
    if operation == "attention-hook":
        from codex_discord.attention_hook import main as hook_main

        return hook_main()

    print(f"unknown operation: {operation}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
